{
  "schema_version": 1,
  "apps": [
    {
      "id": "pack-one",
      "name": "Pack One",
      "source": "killjoy00/mtg-ev-analyzer",
      "ios": {
        "bundle": "pro.packone.app",
        "repo": "killjoy00/mtg-ev-analyzer",
        "workflow": "ios-testflight.yml",
        "request": ".github/testflight-release-request.json",
        "guide": "docs/mobile-release-runbook.md",
        "development": {
          "path": "mobile/store-release.json",
          "key": "appStoreVersion"
        }
      },
      "android": {
        "repo": "killjoy00/mtg-ev-analyzer",
        "workflow": "android-internal-testing.yml",
        "request": ".github/android-internal-release-request.json",
        "guide": "docs/mobile-release-runbook.md",
        "package": "pro.packone.app",
        "development": {
          "path": "mobile/store-release.json",
          "key": "playVersionName"
        }
      }
    },
    {
      "id": "ez-trivia",
      "name": "EZ Trivia",
      "source": "killjoy00/EZTrivia",
      "ios": {
        "bundle": "com.rsm.eztrivia",
        "repo": "killjoy00/EZTrivia",
        "workflow": "testflight.yml",
        "request": ".github/eztrivia-testflight-request.json",
        "guide": "RELEASE_SETUP.md",
        "development": {
          "path": "EZTrivia.xcodeproj/project.pbxproj",
          "pattern": "MARKETING_VERSION\\s*=\\s*([0-9.]+)\\s*;"
        }
      },
      "android": {
        "repo": "killjoy00/EZTrivia",
        "workflow": "android-play-internal.yml",
        "guide": "android/PRODUCTION_RELEASE.md",
        "package": "com.rsm.eztrivia",
        "development": {
          "path": "android/app/build.gradle.kts",
          "pattern": "versionName\\s*=\\s*releaseVersionName\\s*\\?:\\s*\"([0-9.]+(?:-alpha[0-9]+)?)\""
        }
      }
    },
    {
      "id": "gold-rush",
      "name": "Gold Rush",
      "source": "killjoy00/GoldRush",
      "ios": {
        "repo": "killjoy00/GoldRush",
        "workflow": "testflight.yml",
        "guide": "docs/DEPLOYMENT.md",
        "development": {
          "path": "App/GoldRush.xcodeproj/project.pbxproj",
          "pattern": "MARKETING_VERSION\\s*=\\s*([0-9.]+)\\s*;"
        }
      },
      "android": {
        "repo": "killjoy00/GoldRush",
        "workflow": "android-play-release.yml",
        "branch": "play-release",
        "guide": "docs/DEPLOYMENT.md",
        "package": "com.killjoy00.goldrush",
        "development": {
          "path": "Android/app/build.gradle.kts",
          "pattern": "versionName\\s*=\\s*\"([0-9.]+)\""
        }
      }
    },
    {
      "id": "ultimate-ttt",
      "name": "Ultimate Tic/Tac/Toe",
      "source": "killjoy00/Ultttt",
      "ios": {
        "bundle": "com.killjoy00.ultttt",
        "repo": "killjoy00/EZTrivia",
        "workflow": "ultttt-testflight.yml",
        "request": ".github/ultttt-testflight-request.json",
        "development": {
          "path": "project.yml",
          "pattern": "MARKETING_VERSION:\\s*\"([0-9.]+)\""
        }
      },
      "android": {
        "repo": "killjoy00/EZTrivia",
        "guide": "android/PLAY_RELEASE.md",
        "note": "Version-specific adapters; inspect current source and approval before selecting a workflow.",
        "package": "com.killjoy00.ultttt",
        "development": {
          "path": "android/app/build.gradle.kts",
          "pattern": "versionName\\s*=\\s*releaseVersionName\\s*\\?:\\s*\"([0-9.]+)\""
        }
      }
    },
    {
      "id": "star-run",
      "name": "Star/Run",
      "source": "killjoy00/StarRun",
      "ios": {
        "bundle": "com.rsm.starrun",
        "repo": "killjoy00/EZTrivia",
        "workflow": "starrun-testflight.yml",
        "request": ".github/starrun-release-request.json",
        "guide": "docs/NATIVE_DELIVERY.md",
        "development": {
          "path": "export_presets.cfg",
          "pattern": "application/short_version=\"([0-9.]+)\""
        }
      },
      "android": {
        "repo": "killjoy00/EZTrivia",
        "workflow": "starrun-play-internal.yml",
        "request": ".github/starrun-android-release-request.json",
        "guide": "docs/ANDROID_GOOGLE_PLAY.md",
        "package": "com.rsm.starrun",
        "development": {
          "path": "export_presets.cfg",
          "pattern": "version/name=\"([0-9.]+)\""
        }
      }
    },
